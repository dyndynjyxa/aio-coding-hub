{
  "id": "official.association-audit",
  "name": "Association Audit",
  "version": "1.0.0",
  "apiVersion": "1.0.0",
  "description": "Default-off official association audit plugin fixture.",
  "runtime": {
    "kind": "native",
    "engine": "associationAudit"
  },
  "hooks": [
    {
      "name": "gateway.request.afterBodyRead",
      "priority": 90,
      "failurePolicy": "fail-open"
    },
    {
      "name": "gateway.response.chunk",
      "priority": 90,
      "failurePolicy": "fail-open"
    },
    {
      "name": "gateway.response.after",
      "priority": 90,
      "failurePolicy": "fail-open"
    },
    {
      "name": "gateway.error",
      "priority": 90,
      "failurePolicy": "fail-open"
    },
    {
      "name": "log.beforePersist",
      "priority": 90,
      "failurePolicy": "fail-open"
    }
  ],
  "permissions": [
    "request.meta.read",
    "request.body.read",
    "response.body.read",
    "stream.inspect",
    "log.redact",
    "model.invoke"
  ],
  "hostCompatibility": {
    "app": ">=0.60.0 <1.0.0",
    "pluginApi": "^1.0.0",
    "platforms": ["windows", "macos", "linux"]
  },
  "configVersion": 1,
  "configSchema": {
    "type": "object",
    "properties": {
      "mode": {
        "type": "string",
        "default": "off"
      },
      "providerId": {
        "type": "integer",
        "default": 0
      },
      "model": {
        "type": "string",
        "default": ""
      },
      "sampleRate": {
        "type": "integer",
        "default": 10
      },
      "timeoutSeconds": {
        "type": "integer",
        "default": 8
      },
      "maxInputChars": {
        "type": "integer",
        "default": 6000
      },
      "maxOutputChars": {
        "type": "integer",
        "default": 12000
      }
    }
  },
  "category": "security"
}
